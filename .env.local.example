# Template for .env.local (copy it: cp .env.local.example .env.local).
# Names only: never put real values in this file, it is committed.
# Values: Vercel → llar → Settings → Environment Variables, or the Supabase
# dashboard (Project Settings → Data API / API Keys).

# ── Required ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Optional: each enables a feature when set ──────────────────────────────
# AI narrative on unlocked reports (costs money per report).
ANTHROPIC_API_KEY=
# Paid unlock. Leave empty locally unless using Stripe TEST keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Overrides config/brand.ts reportPriceEur at runtime (keep the two in sync).
REPORT_PRICE_EUR=
# Comparable listings (not provisioned).
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
